# Copy this file to .env and fill in real values before running the app.

# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite by default — no external DB needed for local dev)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# AI (Claude API) — get a key at https://console.anthropic.com
# The app runs fine without this key; AI routes will return a friendly
# "AI not configured" message instead of crashing.
ANTHROPIC_API_KEY=
